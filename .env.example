# Copy this file to `.env` (which is gitignored — never commit real tokens)
# and fill in whichever tokens the sources you've enabled actually need.
#
# g3e-data-engine loads `.env` automatically (via python-dotenv) if present,
# from the repo root or your current working directory. You can also just
# export these as real environment variables instead of using a .env file —
# both work identically.
#
# See README.md "Credentials" and configs/datasets.yaml `auth:` blocks.

# Hugging Face — optional for public datasets (avoids the "unauthenticated
# requests" warning + gives higher rate limits), REQUIRED for gated/private
# datasets and for scripts/upload_hf.py / the hf_uploader library function.
HF_TOKEN=

# Roboflow — REQUIRED for any `kind: roboflow` source (no anonymous read path).
ROBOFLOW_API_KEY=

# Reserved for a future `kind: kaggle` downloader (see docs/FUTURE_UPDATES.md).
KAGGLE_KEY=
